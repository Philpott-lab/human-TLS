######################################################
############## MODULE STATISTICS #####################
######################################################

# Replicate-adjusted linear model +
# Dunnett-adjusted comparisons against Control
#
# Control = Full-duration

module_stats <- module_scores %>%
  group_by(module) %>%
  group_modify(
    ~ {
      
      fit <- lm(
        module_score ~
          replicate +
          condition,
        data = .x
      )
      
      emm <- emmeans(
        fit,
        ~ condition
      )
      
      contrast(
        emm,
        method =
          "trt.vs.ctrl",
        ref =
          "Control",
        adjust =
          "mvt"
      ) %>%
        as.data.frame() %>%
        as_tibble()
    }
  ) %>%
  ungroup() %>%
  mutate(
    group1 =
      "Full-duration",
    
    group2 = case_when(
      grepl(
        "Dox d1",
        contrast,
        fixed = TRUE
      ) ~ "Short-term",
      
      grepl(
        "Dox d-1",
        contrast,
        fixed = TRUE
      ) ~ "No/low",
      
      TRUE ~ NA_character_
    ),
    
    comparison_order =
      case_when(
        group2 ==
          "Short-term" ~ 1L,
        group2 ==
          "No/low" ~ 2L,
        TRUE ~ 3L
      ),
    
    sig_label =
      case_when(
        is.na(p.value) ~ "NA",
        p.value < 0.0001 ~ "****",
        p.value < 0.001 ~ "***",
        p.value < 0.01 ~ "**",
        p.value < 0.05 ~ "*",
        TRUE ~ "ns"
      )
  )


######################################################
############ BRACKET POSITIONS #######################
######################################################

module_ranges <- module_scores %>%
  group_by(module) %>%
  summarise(
    y_max = max(
      module_score,
      na.rm = TRUE
    ),
    y_min = min(
      module_score,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    y_range =
      y_max -
      y_min,
    
    y_range =
      if_else(
        !is.finite(y_range) |
          y_range <= 0,
        1,
        y_range
      )
  )

module_stats <- module_stats %>%
  left_join(
    module_ranges,
    by = "module"
  ) %>%
  group_by(module) %>%
  arrange(
    comparison_order,
    .by_group = TRUE
  ) %>%
  mutate(
    y.position =
      y_max +
      0.20 * y_range +
      (
        row_number() - 1
      ) *
      0.23 *
      y_range,
    
    xmin = match(
      group1,
      condition_plot_levels
    ),
    
    xmax = match(
      group2,
      condition_plot_levels
    ),
    
    tip_height =
      0.035 *
      y_range,
    
    label_y =
      y.position +
      0.055 *
      y_range
  ) %>%
  ungroup()


######################################################
############ MODULE PLOT FUNCTION ####################
######################################################

plot_module_scores <- function(
    plot_modules,
    ncol,
    width,
    height,
    filename
) {
  
  panel_dat <- module_scores %>%
    filter(
      module %in% plot_modules
    ) %>%
    mutate(
      module = factor(
        module,
        levels = plot_modules
      ),
      x_num = match(
        condition_plot,
        condition_plot_levels
      )
    )
  
  panel_stats <- module_stats %>%
    filter(
      module %in% plot_modules
    ) %>%
    mutate(
      module = factor(
        module,
        levels = plot_modules
      )
    )
  
  p <- ggplot(
    panel_dat,
    aes(
      x = x_num,
      y = module_score
    )
  ) +
    geom_hline(
      yintercept = 0,
      linetype = "dashed",
      colour = "grey70",
      linewidth = 0.4
    ) +
    geom_boxplot(
      aes(
        group = condition_plot,
        fill = condition_plot
      ),
      width = 0.55,
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.6
    ) +
    geom_point(
      aes(
        fill = condition_plot
      ),
      shape = 21,
      colour = "black",
      stroke = 0.5,
      size = 3,
      position = position_jitter(
        width = 0.08,
        height = 0,
        seed = 1
      )
    ) +
    
    # Horizontal significance brackets
    geom_segment(
      data = panel_stats,
      aes(
        x = xmin,
        xend = xmax,
        y = y.position,
        yend = y.position
      ),
      inherit.aes = FALSE,
      linewidth = 0.4
    ) +
    
    # Left bracket tips
    geom_segment(
      data = panel_stats,
      aes(
        x = xmin,
        xend = xmin,
        y = y.position,
        yend =
          y.position -
          tip_height
      ),
      inherit.aes = FALSE,
      linewidth = 0.4
    ) +
    
    # Right bracket tips
    geom_segment(
      data = panel_stats,
      aes(
        x = xmax,
        xend = xmax,
        y = y.position,
        yend =
          y.position -
          tip_height
      ),
      inherit.aes = FALSE,
      linewidth = 0.4
    ) +
    
    # Significant comparisons
    geom_text(
      data = panel_stats %>%
        filter(
          sig_label != "ns"
        ),
      aes(
        x =
          (xmin + xmax) / 2,
        y = label_y,
        label = sig_label
      ),
      inherit.aes = FALSE,
      size = 5,
      fontface = "bold"
    ) +
    
    # Non-significant comparisons
    geom_text(
      data = panel_stats %>%
        filter(
          sig_label == "ns"
        ),
      aes(
        x =
          (xmin + xmax) / 2,
        y = label_y,
        label = sig_label
      ),
      inherit.aes = FALSE,
      size = 3.5
    ) +
    
    facet_wrap(
      ~ module,
      nrow = 1,
      ncol = ncol,
      scales = "free_y"
    ) +
    
    scale_fill_manual(
      values = group_cols,
      limits = condition_plot_levels,
      drop = FALSE
    ) +
    
    scale_x_continuous(
      breaks = 1:3,
      labels =
        condition_plot_levels,
      limits = c(
        0.5,
        3.5
      )
    ) +
    
    scale_y_continuous(
      expand = expansion(
        mult = c(
          0.04,
          0.32
        )
      )
    ) +
    
    labs(
      x = NULL,
      y = "Module score"
    ) +
    
    theme_classic(
      base_size = 12
    ) +
    
    theme(
      strip.background =
        element_blank(),
      
      strip.text =
        element_text(
          size = 12,
          colour = "black"
        ),
      
      axis.text.x =
        element_text(
          angle = 45,
          hjust = 1,
          vjust = 1,
          size = 10,
          colour = "black"
        ),
      
      axis.text.y =
        element_text(
          size = 11,
          colour = "black"
        ),
      
      axis.title.y =
        element_text(
          size = 12,
          colour = "black"
        ),
      
      axis.line =
        element_line(
          colour = "black",
          linewidth = 0.5
        ),
      
      axis.ticks =
        element_line(
          colour = "black",
          linewidth = 0.5
        ),
      
      legend.position =
        "none"
    )
  
  ggsave(
    file.path(
      plot_dir,
      filename
    ),
    p,
    width = width,
    height = height
  )
  
  p
}


