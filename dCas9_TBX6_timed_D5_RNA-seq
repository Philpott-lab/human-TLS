plot_gene_panel <- function(
    marker,
    show_y_title = FALSE,
    show_x_text = TRUE
) {
  
  gene_dat <- gene_counts %>%
    filter(
      gene == marker
    )
  
  gene_stat <- gene_stats %>%
    filter(
      gene == marker
    ) %>%
    as.data.frame()
  
  if (nrow(gene_dat) == 0) {
    stop(
      marker,
      " was not found in the expression matrix."
    )
  }
  
  p <- ggplot(
    gene_dat,
    aes(
      x = condition_plot,
      y = log_counts
    )
  ) +
    geom_boxplot(
      aes(
        fill = condition_plot
      ),
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.6,
      width = 0.6
    ) +
    geom_point(
      aes(
        fill = condition_plot
      ),
      position = position_jitter(
        width = 0.08,
        height = 0,
        seed = 1
      ),
      shape = 21,
      colour = "black",
      stroke = 0.5,
      size = 3
    ) +
    stat_pvalue_manual(
      gene_stat,
      label = "p_label",
      xmin = "group1",
      xmax = "group2",
      y.position = "y.position",
      tip.length = 0.01,
      bracket.size = 0.4,
      size = 3.2,
      step.increase = 0
    ) +
    scale_fill_manual(
      values = group_cols,
      limits = condition_plot_levels,
      drop = FALSE
    ) +
    scale_x_discrete(
      limits = condition_plot_levels,
      drop = FALSE,
      expand = expansion(
        add = c(
          0.28,
          0.28
        )
      )
    ) +
    scale_y_continuous(
      expand = expansion(
        mult = c(
          0.02,
          0.12
        )
      )
    ) +
    labs(
      title = marker,
      x = NULL,
      y = if (
        show_y_title
      ) {
        "log10(normalized counts + 1)"
      } else {
        NULL
      }
    ) +
    theme_classic(
      base_size = 12
    ) +
    theme(
      plot.title = element_text(
        face = "italic",
        size = 16,
        hjust = 0.5,
        colour = "black"
      ),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1,
        vjust = 1,
        size = 14,
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 12,
        colour = "black"
      ),
      axis.title.y = element_text(
        size = 12,
        colour = "black"
      ),
      axis.line = element_line(
        colour = "black",
        linewidth = 0.5
      ),
      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.5
      ),
      legend.position = "none",
      plot.margin = margin(
        10,
        14,
        10,
        14
      )
    )
  
  if (!show_y_title) {
    p <- p +
      theme(
        axis.title.y =
          element_blank()
      )
  }
  
  if (!show_x_text) {
    p <- p +
      theme(
        axis.text.x =
          element_blank(),
        axis.ticks.x =
          element_blank()
      )
  }
  
  p
}


