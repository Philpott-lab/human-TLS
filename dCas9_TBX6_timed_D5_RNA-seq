# Force integer counts for DESeq2

count_df <- data.frame(
  lapply(
    QP38Y5_counts,
    function(x) as.integer(as.character(x))
  ),
  row.names = rownames(QP38Y5_counts),
  check.names = FALSE
)

# Final count matrix used by DESeq2

