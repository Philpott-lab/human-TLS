######################################################
############ CALCULATE MODULE SCORES #################
######################################################

calculate_module_score <- function(
    genes,
    module_name
) {
  
  genes_present <- intersect(
    unique(genes),
    rownames(vsd_mat)
  )
  
  if (
    length(genes_present) < 2
  ) {
    stop(
      module_name,
      " has fewer than 2 genes present in the expression matrix."
    )
  }
  
  module_mat <- vsd_mat[
    genes_present,
    ,
    drop = FALSE
  ]
  
  # z-score each gene across samples
  module_mat_z <- t(
    scale(
      t(module_mat)
    )
  )
  
  tibble(
    sample =
      colnames(module_mat_z),
    module =
      module_name,
    module_score =
      colMeans(
        module_mat_z,
        na.rm = TRUE
      )
  )
}

module_scores <- bind_rows(
  lapply(
    names(score_modules),
    function(module_name) {
      
      calculate_module_score(
        genes =
          score_modules[[module_name]
          ],
        module_name =
          module_name
      )
    }
  )
)

