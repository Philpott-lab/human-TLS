  drop = FALSE
]


######################################################
###################### METADATA ######################
######################################################

metaData <- data.frame(
  sample = colnames(count_mat)
) %>%
  mutate(
    replicate = str_extract(
      sample,
      "rep_[0-9]+"
    ),
    condition = case_when(
      str_detect(
        sample,
        "_ct_"
      ) ~ "Control",

      str_detect(
        sample,
        "Dox_d-1"
      ) ~ "Dox d-1",

      str_detect(
        sample,
        "Dox_d1"
      ) ~ "Dox d1"
    )
  )

rownames(metaData) <- metaData$sample
metaData$sample <- NULL

# Keep Control as the DESeq2 reference level

metaData$condition <- factor(
  metaData$condition,
  levels = c(
    "Control",
    "Dox d1",
    "Dox d-1"
  )
)

metaData$replicate <- factor(
  metaData$replicate
)

# Confirm metadata and count matrix are in the same order

