      comparison_order = 2L
    ),
  
  as.data.frame(
    res_Dox_d1_vs_Control
  ) %>%
    rownames_to_column("gene") %>%
    filter(
      gene %in% panel_markers
    ) %>%
    mutate(
      group1 = "Short-term",
      group2 = "Full-duration",
      comparison_order = 1L
    )
) %>%
  mutate(
    p_label = case_when(
      is.na(padj) ~ "FDR=NA",
      padj < 0.001 ~ "FDR<0.001",
      TRUE ~ paste0(
        "FDR=",
        signif(padj, 2)
      )
    )
  )

gene_ranges <- gene_counts %>%
  group_by(gene) %>%
  summarise(
    y_max = max(
      log_counts,
      na.rm = TRUE
    ),
    y_min = min(
      log_counts,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    y_range = y_max - y_min,
    y_range = ifelse(
      !is.finite(y_range) |
        y_range <= 0,
      1,
      y_range
    )
  )

gene_stats <- gene_stats %>%
  left_join(
    gene_ranges,
    by = "gene"
  ) %>%
  group_by(gene) %>%
  arrange(
    comparison_order,
    .by_group = TRUE
  ) %>%
  mutate(
    y.position =
      y_max +
      row_number() *
      y_range *
      0.25
  ) %>%
  ungroup()


