  "QP38Y5_",
  names(sample_key),
  "_count"
)

# Select only the Day 5 samples

QP38Y5_counts <- QP38Y5_matrix %>%
  as_tibble(rownames = "gene") %>%
  select(
    gene,
    all_of(count_columns)
  ) %>%
  mutate(
    across(-gene, as.numeric)
  ) %>%
  column_to_rownames("gene")

