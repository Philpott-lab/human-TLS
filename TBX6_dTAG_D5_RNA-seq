make_gene_plot <- function(
    marker,
    show_y_title = FALSE,
    show_x_text = TRUE
) {
  
  gene_dat <- norm_counts_4 %>%
    filter(
      gene == marker
    )
  
  if (nrow(gene_dat) == 0) {
    stop(
      marker,
      " was not found in the expression matrix."
    )
  }
  
  p <- ggplot(
    gene_dat,
    aes(
      x = condition,
      y = log_count
    )
  ) +
    geom_boxplot(
      aes(fill = condition),
      width = 0.62,
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.45,
      alpha = 0.55
    ) +
    geom_point(
      aes(fill = condition),
      shape = 21,
      position = position_jitter(
        width = 0.06,
        height = 0,
        seed = 1
      ),
      size = 3.1,
      stroke = 0.65,
      colour = "black"
    ) +
    scale_fill_manual(
      values = group_cols_4,
      breaks = condition_levels_4,
      labels = condition_labels_4,
      drop = FALSE
    ) +
    scale_x_discrete(
      limits = condition_levels_4,
      labels = condition_labels_4,
      drop = FALSE
    ) +
    scale_y_continuous(
      expand = expansion(
        mult = c(
          0.05,
          0.10
        )
      )
    ) +
    labs(
      title = marker,
      x = NULL,
      y = if (
        show_y_title
      ) {
        "log10 normalized counts + 1"
      } else {
        NULL
      }
    ) +
    theme_nature +
    theme(
      plot.title = element_text(
        face = "italic",
        size = 12,
        hjust = 0.5,
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 10,
        colour = "black"
      ),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1,
        vjust = 1,
        size = 10,
        colour = "black"
      ),
      axis.title.y = element_text(
        size = 11,
        colour = "black"
      ),
      legend.position = "none"
    )
  
  if (!show_y_title) {
    p <- p +
      theme(
        axis.title.y =
          element_blank()
      )
  }
  
  if (!show_x_text) {
    p <- p +
      theme(
        axis.text.x =
          element_blank(),
        axis.ticks.x =
          element_blank()
      )
  }
  
  p
}


