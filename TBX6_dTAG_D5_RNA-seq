# Top 100 positive scRNA-seq markers with pct.1 > 0.1

read_top_module <- function(
    filename,
    n = 100
) {
  
  read.csv(
    file.path(
      marker_dir,
      filename
    )
  ) %>%
    filter(
      pct.1 > 0.1
    ) %>%
    slice_head(
      n = n
    ) %>%
    pull(X) %>%
    as.character() %>%
    unique() %>%
    na.omit()
}

