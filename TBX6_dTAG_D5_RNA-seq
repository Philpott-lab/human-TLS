######################################################
############ CALCULATE MODULE SCORES #################
######################################################

calculate_module_score <- function(
    genes,
    module_name
) {
  
  genes_present <- intersect(
    genes,
    rownames(vsd_mat)
  )
  
  if (length(genes_present) < 2) {
    stop(
      module_name,
      " has fewer than 2 genes present."
    )
  }
  
  module_mat <- vsd_mat[
    genes_present,
    ,
    drop = FALSE
  ]
  
  # Remove genes with zero variance
  
  gene_sd <- apply(
    module_mat,
    1,
    sd,
    na.rm = TRUE
  )
  
  module_mat <- module_mat[
    is.finite(gene_sd) &
      gene_sd > 0,
    ,
    drop = FALSE
  ]
  
  if (nrow(module_mat) < 2) {
    stop(
      module_name,
      " has fewer than 2 variable genes."
    )
  }
  
  # z-score each gene across samples
  
  module_z <- t(
    scale(
      t(module_mat)
    )
  )
  
  tibble(
    sample = colnames(module_z),
    module = module_name,
    module_score = colMeans(
      module_z,
      na.rm = TRUE
    )
  )
}

module_scores <- purrr::imap_dfr(
  modules,
  ~ calculate_module_score(
    .x,
    .y
  )
) %>%
  left_join(
    as.data.frame(metaData) %>%
      rownames_to_column("sample"),
    by = "sample"
  ) %>%
  mutate(
    condition = factor(
      condition,
      levels = condition_levels
    ),
    replicate = factor(
      replicate
    ),
    module = factor(
      module,
      levels = c(
        "Kidney module",
        "Somite module",
        "Neural module"
      )
    )
  )


######################################################
############### MODULE STATISTICS ####################
######################################################

# Replicate-adjusted comparisons shown in S4R:
#
# Control vs Dox
# Dox vs Dox + dTAG d0
# Dox vs Dox + dTAG d2

module_stats <- module_scores %>%
  group_by(module) %>%
  group_modify(
    ~ {
      
      fit <- lm(
        module_score ~
          replicate +
          condition,
        data = .x
      )
      
      emm <- emmeans(
        fit,
        ~ condition
      )
      
      contrast_matrix <- list(
        
        "Control vs Doxd-1" =
          c(
            1,
            0,
            0,
            -1,
            0,
            0
          ),
        
        "Doxd-1 vs Doxd-1_dTagd0" =
          c(
            0,
            0,
            0,
            1,
            -1,
            0
          ),
        
        "Doxd-1 vs Doxd-1_dTagd2" =
          c(
            0,
            0,
            0,
            1,
            0,
            -1
          )
      )
      
      contrast(
        emm,
        method = contrast_matrix,
        adjust = "none"
      ) %>%
        as.data.frame() %>%
        as_tibble()
    }
  ) %>%
  ungroup() %>%
  mutate(
    
    group1 = ifelse(
      contrast ==
        "Control vs Doxd-1",
      "Control",
      "Doxd-1"
    ),
    
    group2 = case_when(
      
      contrast ==
        "Control vs Doxd-1" ~
        "Doxd-1",
      
      contrast ==
        "Doxd-1 vs Doxd-1_dTagd0" ~
        "Doxd-1_dTagd0",
      
      contrast ==
        "Doxd-1 vs Doxd-1_dTagd2" ~
        "Doxd-1_dTagd2"
    ),
    
    p_label = case_when(
      is.na(p.value) ~ "p=NA",
      p.value < 0.001 ~ "p<0.001",
      TRUE ~ paste0(
        "p=",
        signif(p.value, 2)
      )
    )
  )


######################################################
############### MODULE PLOT FUNCTION #################
######################################################

make_module_plot <- function(
    module_name
) {
  
  dat <- module_scores %>%
    filter(
      module == module_name
    ) %>%
    mutate(
      condition = factor(
        as.character(condition),
        levels = condition_levels
      )
    ) %>%
    droplevels()
  
  y_min <- min(
    dat$module_score,
    na.rm = TRUE
  )
  
  y_max <- max(
    dat$module_score,
    na.rm = TRUE
  )
  
  y_range <- y_max - y_min
  
  if (
    !is.finite(y_range) ||
    y_range == 0
  ) {
    y_range <- 1
  }
  
  stats_dat <- module_stats %>%
    filter(
      module == module_name
    ) %>%
    arrange(
      factor(
        contrast,
        levels = c(
          "Control vs Doxd-1",
          "Doxd-1 vs Doxd-1_dTagd0",
          "Doxd-1 vs Doxd-1_dTagd2"
        )
      )
    ) %>%
    mutate(
      y.position =
        y_max +
        row_number() *
        y_range *
        0.18
    )
  
  ggplot(
    dat,
    aes(
      x = condition,
      y = module_score
    )
  ) +
    geom_hline(
      yintercept = 0,
      linetype = "dashed",
      colour = "grey70",
      linewidth = 0.4
    ) +
    geom_boxplot(
      aes(fill = condition),
      width = 0.62,
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.5,
      alpha = 0.75
    ) +
    geom_point(
      aes(fill = condition),
      shape = 21,
      position = position_jitter(
        width = 0.08,
        height = 0,
        seed = 1
      ),
      size = 2.8,
      stroke = 0.55,
      colour = "black"
    ) +
    stat_pvalue_manual(
      stats_dat,
      label = "p_label",
      xmin = "group1",
      xmax = "group2",
      y.position = "y.position",
      tip.length = 0.008,
      bracket.size = 0.35,
      size = 3
    ) +
    scale_fill_manual(
      values = group_cols,
      breaks = condition_levels,
      labels = condition_labels,
      drop = FALSE
    ) +
    scale_x_discrete(
      limits = condition_levels,
      labels = condition_labels,
      drop = FALSE
    ) +
    scale_y_continuous(
      expand = expansion(
        mult = c(
          0.04,
          0.30
        )
      )
    ) +
    labs(
      x = NULL,
      y = "Module score\n(mean z-scored VST expression)",
      title = module_name
    ) +
    theme_nature +
    theme(
      plot.title = element_text(
        size = 12,
        hjust = 0.5,
        colour = "black"
      ),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1,
        vjust = 1,
        size = 10,
        colour = "black"
      ),
      legend.position = "none"
    )
}


