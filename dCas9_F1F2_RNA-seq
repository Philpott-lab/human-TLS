library(dplyr)
library(clusterProfiler)
library(enrichplot)
library(stringr)

## ------------------------------------------------------------
## 1. Build ranked gene list for GSEA
##    Use the Wald statistic (same sign as log2FC)
## ------------------------------------------------------------

res <- as.data.frame(res)
gene_ranks <- res$stat
names(gene_ranks) <- rownames(res)
gene_ranks <- gene_ranks[!is.na(gene_ranks)]
gene_ranks <- sort(gene_ranks, decreasing = TRUE)


##################################################################################
###################### GSEA: Fetal human nephron markers - Figure S5K ############
##################################################################################

# Path to marker genes for human fetal nephron, Stewart et al., 2018
kidney_markers_Stewart_fetal <- read.csv(file = "~/Desktop/dCas9F1F2 RNA-seq/aat5031_data_s3_fetal.csv")

# Make sure Gene and Cell.type are character, not factors
kidney_markers_Stewart_fetal$Gene      <- as.character(kidney_markers_Stewart_fetal$Gene)
kidney_markers_Stewart_fetal$Cell.type <- as.character(kidney_markers_Stewart_fetal$Cell.type)

# Split genes by cell type
kidney_markers_fetal <- split(
  kidney_markers_Stewart_fetal$Gene,
  kidney_markers_Stewart_fetal$Cell.type
)

head(kidney_markers_fetal)

# Clean up: remove duplicates & sort
kidney_markers_fetal <- lapply(kidney_markers_fetal, function(x) sort(unique(x)))

# Optional: make sure terms have nice names
names(kidney_markers_fetal) <- str_replace_all(names(kidney_markers_fetal), "_", " ")

## ------------------------------------------------------------
## 3. Build TERM2GENE data.frame for custom GSEA
## ------------------------------------------------------------

TERM2GENE_kidney <- do.call(
  rbind,
  lapply(names(kidney_markers_fetal), function(ct) {
    data.frame(
      term = ct,
      gene = kidney_markers_fetal[[ct]],
      stringsAsFactors = FALSE
    )
  })
)

# Optional sanity check:
head(TERM2GENE_kidney)

## IMPORTANT: gene IDs in TERM2GENE must match names(gene_ranks)
## If your gene_ranks uses SYMBOLS, make sure TERM2GENE_kidney$gene are SYMBOLS too.

## ------------------------------------------------------------
## 4. Run multi-set GSEA with smaller minGSSize
## ------------------------------------------------------------

gsea_kidney_multi <- GSEA(
  geneList     = gene_ranks,
  TERM2GENE    = TERM2GENE_kidney,
  pvalueCutoff = 1,      # keep all, we’ll filter by padj later
  minGSSize    = 5       # allow smaller sets to be tested
)

# Look at the basic result table
gsea_kidney_multi@result[, c("ID", "setSize", "NES", "p.adjust")] %>%
  arrange(p.adjust) %>%
  head()

## ------------------------------------------------------------
## 5. Compute pairwise term similarity (for plotting)
## ------------------------------------------------------------

gsea_kidney_multi <- pairwise_termsim(gsea_kidney_multi)


## ------------------------------------------------------------
## 6. Ridgeplot
## ------------------------------------------------------------
