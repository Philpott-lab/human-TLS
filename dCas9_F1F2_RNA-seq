#######FIX THE LIST!!!!##############
#Short version:
#SEPT genes got turned into dates by Excel (e.g. SEPT6 → "06-Sep").
#The brain-region abbreviations FB, HB, MB, SC were globally replaced by full words (Forebrain progenitor, Hindbrain progenitor, Midbrain progenitor, Spinal cord progenitor) inside gene symbols, not just in labels.

## Function to repair a character vector of gene symbols
fix_zeng_genes <- function(genes) {
  # 1. Undo the FB/HB/MB/SC → full-text replacements
  genes <- gsub("Forebrain progenitor", "FB", genes, fixed = TRUE)
  genes <- gsub("Hindbrain progenitor",  "HB", genes, fixed = TRUE)
  genes <- gsub("Midbrain progenitor",   "MB", genes, fixed = TRUE)
  genes <- gsub("Spinal cord progenitor","SC", genes, fixed = TRUE)
  
  # 2. Fix the SEPT genes that became dates
  sept_map <- c(
    "06-Sep" = "SEPT6",
    "07-Sep" = "SEPT7",
    "09-Sep" = "SEPT9",
    "11-Sep" = "SEPT11"
  )
  idx <- match(genes, names(sept_map))
  genes[!is.na(idx)] <- sept_map[idx[!is.na(idx)]]
  
  genes
}

