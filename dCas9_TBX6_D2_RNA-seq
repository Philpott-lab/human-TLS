######################################################
################ MODULE STATISTICS ###################
######################################################

module_stats <- module_scores_all %>%
  group_by(module) %>%
  group_modify(~ {
    
    fit <- lm(
      module_score ~ replicate + condition,
      data = .x
    )
    
    emm <- emmeans(
      fit,
      ~ condition
    )
    
    contrast(
      emm,
      method = "trt.vs.ctrl",
      ref = "D2 Control",
      adjust = "none"
    ) %>%
      as.data.frame() %>%
      as_tibble() %>%
      transmute(
        group1 = "Control",
        group2 = "Dox",
        p.value = p.value
      )
  }) %>%
  ungroup() %>%
  mutate(
    p_label = case_when(
      p.value < 0.001 ~ "p<0.001",
      TRUE ~ paste0(
        "p=",
        signif(p.value, 2)
      )
    )
  )

module_y <- module_scores_all %>%
  group_by(module) %>%
  summarise(
    y_max = max(module_score),
    y_min = min(module_score),
    .groups = "drop"
  ) %>%
  mutate(
    y_min_plot = pmin(
      y_min,
      -1
    ),
    y_range = y_max - y_min_plot,
    y.position = y_max + 0.20 * y_range
  )

module_stats <- module_stats %>%
  left_join(
    module_y,
    by = "module"
  )


######################################################
################ MODULE PLOT FUNCTION ################
######################################################

make_module_panel <- function(
    modules,
    panel_title,
    ncol_panel
) {
  
  panel_dat <- module_scores_all %>%
    filter(module %in% modules) %>%
    mutate(
      module = factor(
        module,
        levels = modules
      )
    )
  
  panel_stats <- module_stats %>%
    filter(module %in% modules) %>%
    mutate(
      module = factor(
        module,
        levels = modules
      )
    )
  
  lower_anchor <- tibble(
    module = factor(
      modules,
      levels = modules
    ),
    condition_plot = factor(
      "Control",
      levels = c(
        "Control",
        "Dox"
      )
    ),
    module_score = -1
  )
  
  ggplot(
    panel_dat,
    aes(
      x = condition_plot,
      y = module_score
    )
  ) +
    geom_blank(
      data = lower_anchor,
      aes(
        x = condition_plot,
        y = module_score
      ),
      inherit.aes = FALSE
    ) +
    geom_hline(
      yintercept = 0,
      linetype = "dashed",
      colour = "grey70",
      linewidth = 0.4
    ) +
    geom_boxplot(
      aes(fill = condition_plot),
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.6,
      width = 0.6
    ) +
    geom_point(
      aes(fill = condition_plot),
      position = position_jitter(
        width = 0.08,
        height = 0
      ),
      shape = 21,
      colour = "black",
      stroke = 0.5,
      size = 3
    ) +
    stat_pvalue_manual(
      panel_stats,
      label = "p_label",
      xmin = "group1",
      xmax = "group2",
      y.position = "y.position",
      tip.length = 0.01,
      bracket.size = 0.4,
      size = 5,
      vjust = -0.6
    ) +
    ggh4x::facet_wrap2(
      ~ module,
      scales = "free_y",
      ncol = ncol_panel,
      axes = "all",
      remove_labels = "none"
    ) +
    scale_fill_manual(
      values = group_cols_boxplot
    ) +
    scale_y_continuous(
      expand = expansion(
        mult = c(0, 0.18)
      )
    ) +
    labs(
      title = panel_title,
      x = NULL,
      y = "Module score\n(mean z-scored VST expression)"
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(
        size = 15,
        hjust = 0.5
      ),
      strip.background = element_blank(),
      strip.text = element_text(
        size = 13
      ),
      axis.text.x = element_text(
        size = 13,
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 13,
        colour = "black"
      ),
      axis.title.y = element_text(
        size = 15,
        colour = "black"
      ),
      legend.position = "none"
    )
}


