###################### METADATA ######################
######################################################

metaData <- data.frame(
  sample = colnames(count_mat)
) %>%
  mutate(
    replicate = str_extract(sample, "rep_[0-9]+"),
    condition = case_when(
      str_detect(sample, "hTLS66_D2_ct") ~ "D2 Control",
      str_detect(sample, "hTLS66_D2_Dox_d-1") ~ "D2 Dox"
    )
  )

rownames(metaData) <- metaData$sample
metaData$sample <- NULL

metaData$condition <- factor(
  metaData$condition,
  levels = c("D2 Control", "D2 Dox")
)

metaData$replicate <- factor(metaData$replicate)

stopifnot(
  all(rownames(metaData) == colnames(count_mat))
)


######################################################
###################### DESEQ2 ########################
######################################################

dds <- DESeqDataSetFromMatrix(
  countData = count_mat,
  colData = metaData,
  design = ~ replicate + condition
)

dds <- DESeq(dds)

res_D2_Dox_vs_Control <- results(
  dds,
  contrast = c(
    "condition",
    "D2 Dox",
