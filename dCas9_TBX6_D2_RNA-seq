######################################################
################### DESEQ2 FDR #######################
######################################################

gene_stats <- as.data.frame(
  res_D2_Dox_vs_Control
) %>%
  rownames_to_column("gene") %>%
  filter(gene %in% genes_to_plot) %>%
  mutate(
    group1 = "Control",
    group2 = "Dox",
    p_label = case_when(
      is.na(padj) ~ "FDR=NA",
      padj < 0.001 ~ "FDR<0.001",
      TRUE ~ paste0(
        "FDR=",
        signif(padj, 2)
      )
    )
  )

y_positions <- gene_counts_all %>%
  group_by(gene) %>%
  summarise(
    y_max = max(log_counts),
    y_min = min(log_counts),
    .groups = "drop"
  ) %>%
  mutate(
    y_range = y_max - y_min,
    y_range = ifelse(
      y_range == 0,
      1,
      y_range
    ),
    y.position = y_max + 0.25 * y_range
  )

gene_stats <- gene_stats %>%
  left_join(
    y_positions,
    by = "gene"
  )


######################################################
################ GENE PLOT FUNCTION ##################
######################################################

make_gene_plot <- function(marker) {
  
  gene_dat <- gene_counts_all %>%
    filter(gene == marker)
  
  gene_stat <- gene_stats %>%
    filter(gene == marker)
  
  # Skip genes not present in the matrix
  if (nrow(gene_dat) == 0) {
    message(
      marker,
      " not found in expression matrix - skipping."
    )
    return(NULL)
  }
  
  p_gene <- ggplot(
    gene_dat,
    aes(
      x = condition_plot,
      y = log_counts
    )
  ) +
    geom_boxplot(
      aes(fill = condition_plot),
      outlier.shape = NA,
      colour = "black",
      linewidth = 0.6,
      width = 0.6
    ) +
    geom_point(
      aes(fill = condition_plot),
      position = position_jitter(
        width = 0.08,
        height = 0
      ),
      shape = 21,
      colour = "black",
      stroke = 0.5,
      size = 3
    ) +
    stat_pvalue_manual(
      gene_stat,
      label = "p_label",
      xmin = "group1",
      xmax = "group2",
      y.position = "y.position",
      tip.length = 0.01,
      bracket.size = 0.4,
      size = 5,
      vjust = -0.6
    ) +
    scale_fill_manual(
      values = group_cols_boxplot
    ) +
    scale_y_continuous(
      expand = expansion(
        mult = c(0.02, 0.16)
      )
    ) +
    labs(
      title = marker,
      x = NULL,
      y = "log10 normalized counts + 1"
    ) +
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(
        face = "italic",
        size = 22,
        hjust = 0.5,
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 16,
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 18,
        colour = "black"
      ),
      axis.title.y = element_text(
        size = 18,
        colour = "black"
      ),
      legend.position = "none"
    )
  
  ggsave(
    file.path(
      plot_dir,
      paste0(
        "QP38Y5_hTLS66_D2_",
        marker,
        "_boxplot_TBX6_knockdown_vs_Control_DESeq2_FDR.pdf"
      )
    ),
    p_gene,
    width = 4.5,
    height = 5
  )
}


