######################################################
############ CALCULATE MODULE SCORES #################
######################################################

calculate_module_score <- function(
    genes,
    module_name
) {
  
  genes_present <- intersect(
    unique(genes),
    rownames(vsd_mat)
  )
  
  if (length(genes_present) < 2) {
    stop(
      module_name,
      ": fewer than two genes found."
    )
  }
  
  module_mat <- vsd_mat[
    genes_present,
    ,
    drop = FALSE
  ]
  
  module_mat_z <- t(
    scale(
      t(module_mat)
    )
  )
  
  tibble(
    sample = colnames(vsd_mat),
    module = module_name,
    module_score = colMeans(
      module_mat_z,
      na.rm = TRUE
    )
  )
}

module_scores_all <- bind_rows(
  lapply(
    names(score_modules),
    function(module_name) {
      calculate_module_score(
        score_modules[[module_name]],
        module_name
      )
    }
  )
)

module_scores_all <- module_scores_all %>%
  left_join(
    as.data.frame(colData(dds)) %>%
      rownames_to_column("sample") %>%
      select(
        sample,
        condition,
        replicate
