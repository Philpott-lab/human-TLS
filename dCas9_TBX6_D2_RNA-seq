######################################################
################ ISOLATE COUNT DATA ##################
######################################################

QP38Y5_counts <- QP38Y5_matrix %>%
  as_tibble(rownames = "gene") %>%
  select(gene, matches("^QP38Y5_[0-9]+_count$")) %>%
  mutate(across(-gene, as.numeric)) %>%
  column_to_rownames("gene")

sample_num <- as.integer(
  str_extract(
    colnames(QP38Y5_counts),
    "(?<=QP38Y5_)[0-9]+"
  )
)

QP38Y5_counts <- QP38Y5_counts[, order(sample_num)]
sample_num <- sort(sample_num)

colnames(QP38Y5_counts) <- sample_key$sample_name[
  match(sample_num, sample_key$sample_num)
]

count_df <- data.frame(
  lapply(
    QP38Y5_counts,
    function(x) as.integer(as.character(x))
  ),
  row.names = rownames(QP38Y5_counts),
  check.names = FALSE
)

count_mat_all <- as.matrix(count_df)
count_mat_all <- count_mat_all[complete.cases(count_mat_all), ]


