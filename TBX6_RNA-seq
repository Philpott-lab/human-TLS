################################################################
##################### Making TBX6 module score for Zeng ########
################################################################

res_tb_sig <- res_tb %>%
  as.data.frame() %>%
  dplyr::filter(!is.na(padj), padj < 0.05, log2FoldChange > 2) %>%
  dplyr::arrange(desc(log2FoldChange))

n_top <- 500
pcw_genes <- rownames(PCW3.sub)

tbx6_module_use <- res_tb_sig %>%
  dplyr::filter(!grepl("^ENS", X)) %>%
  dplyr::filter(X %in% pcw_genes) %>%
  dplyr::arrange(desc(log2FoldChange)) %>%
  dplyr::slice_head(n = min(n_top, nrow(.))) %>%
  dplyr::pull(X)



#############################################################################################################
######################## Checking overlap between Tyser and Zeng TBX6 module scores #########################
#############################################################################################################

genes_typer <- tbx6_module_ens
genes_zeng <- tbx6_module_use

tyser_symbols <- conv %>%
  dplyr::filter(ensembl_gene_id %in% genes_typer) %>%
  dplyr::pull(hgnc_symbol) %>%
  unique()

tyser_symbols <- tyser_symbols[!is.na(tyser_symbols)]
gene_overlap <- intersect(tyser_symbols, genes_zeng)

cat("Tyser genes:", length(tyser_symbols), "\n")
cat("Zeng genes:", length(genes_zeng), "\n")
cat("Overlap:", length(gene_overlap), "\n")

gene_overlap

######################################################
########## Making a shared TBX6 module score #########
######################################################

shared_tbx6_genes <- sort(gene_overlap)

shared_tbx6_ensg_tyser <- conv %>%
  dplyr::filter(
    hgnc_symbol %in% shared_tbx6_genes,
    ensembl_gene_id %in% rownames(Tyser)
  ) %>%
  dplyr::pull(ensembl_gene_id) %>%
  unique()

Tyser <- AddModuleScore(
  Tyser,
  features = list(shared_tbx6_ensg_tyser),
  name = "TBX6_shared"
)

shared_tbx6_zeng <- intersect(shared_tbx6_genes, rownames(PCW3.sub))

PCW3.sub <- AddModuleScore(
  PCW3.sub,
  features = list(shared_tbx6_zeng),
  name = "TBX6_shared"
)


