zeng_metadata <- zeng_metadata[, c("week_stage", "louvain", "cell_type",
                                   "umap1", "umap2", "barcode")]

zeng_metadata <- subset(
  zeng_metadata,
  barcode != "" & !is.na(barcode) & !duplicated(barcode)
)

rownames(zeng_metadata) <- zeng_metadata$barcode

common_cells <- intersect(colnames(PCW3.sub), zeng_metadata$barcode)
PCW3.sub <- subset(PCW3.sub, cells = common_cells)

umap_use <- as.matrix(zeng_metadata[common_cells, c("umap1", "umap2")])
colnames(umap_use) <- c("UMAP_1", "UMAP_2")
rownames(umap_use) <- common_cells

PCW3.sub[["zeng.umap"]] <- CreateDimReducObject(
  embeddings = umap_use,
  key = "ZengUMAP_",
  assay = DefaultAssay(PCW3.sub)
)

PCW3.sub$cell_type  <- zeng_metadata[common_cells, "cell_type"]
PCW3.sub$week_stage <- zeng_metadata[common_cells, "week_stage"]
PCW3.sub$louvain    <- zeng_metadata[common_cells, "louvain"]

PCW3.sub@meta.data$cell_type <- dplyr::recode(
  PCW3.sub@meta.data$cell_type,
  "Erythroid" = "Primitive Erythroid",
  "Paraxial mesoderm" = "Paraxial Mesoderm",
  "Neural tbue 1" = "Neural Tube 1",
  "Neural tbue 2" = "Neural Tube 2",
  "Neural tbue 3" = "Neural Tube 3"
)


