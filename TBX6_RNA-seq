res_tb <- read.csv(file = "~/Desktop/TBX6 RNA-seq/res_tbx6.csv")  # res_tbx6 is res

# Filter by significance & direction
res_tb_sig <- res_tb %>%
  as.data.frame() %>%
  filter(!is.na(padj),
         padj < 0.05,
         log2FoldChange > 2) %>%
  arrange(desc(log2FoldChange))

n_top <- 500

options(timeout = 120)

mart <- useEnsembl("genes", dataset = "hsapiens_gene_ensembl")

conv <- getBM(
  attributes = c("hgnc_symbol", "ensembl_gene_id"),
  filters    = "hgnc_symbol",
  values     = unique(res_tb_sig$X),
  mart       = mart
)

# Join Ensembl IDs onto DE results
res_tb_sig2 <- res_tb_sig %>%
  left_join(conv, by = c("X" = "hgnc_symbol")) %>%
  # keep only rows with a valid Ensembl ID
  filter(!is.na(ensembl_gene_id)) %>%
  # keep only genes that are actually present in Tyser
  filter(ensembl_gene_id %in% rownames(Tyser)) %>%
  # make sure each Ensembl ID appears only once (take highest log2FC if duplicated)
  arrange(desc(log2FoldChange)) %>%
