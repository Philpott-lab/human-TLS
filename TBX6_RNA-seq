cells_file  <- file.path(data_dir, "E-MTAB-9388.aggregated_filtered_normalised_counts.mtx_cols.gz")

# Load count matrix
counts <- readMM(gzfile(counts_file))

# Read gene and cell names
genes <- read.delim(gzfile(genes_file), header = FALSE, stringsAsFactors = FALSE)
cells <- read.delim(gzfile(cells_file), header = FALSE, stringsAsFactors = FALSE)

rownames(counts) <- genes[[1]]
colnames(counts) <- cells[[1]]

# Create Seurat object
Tyser <- CreateSeuratObject(
  counts = counts,
  project = "Tyser_CS7",
  min.cells = 0,
  min.features = 0
)

# Add metadata
meta_file <- file.path(data_dir, "E-MTAB-9388.cell_metadata.tsv")
meta <- read.delim(meta_file, stringsAsFactors = FALSE)
meta2 <- meta[match(colnames(Tyser), meta$id), ]
rownames(meta2) <- meta2$id
Tyser <- AddMetaData(Tyser, metadata = meta2)

# Import UMAP and attach as reduction
umap_file <- file.path(data_dir, "E-MTAB-9388.umap_neigh_10.tsv")
umap <- read.delim(umap_file, stringsAsFactors = FALSE)

cell_ids_umap <- umap[[1]]
common_cells <- intersect(colnames(Tyser), cell_ids_umap)
Tyser <- subset(Tyser, cells = common_cells)

rownames(umap) <- umap[[1]]
umap_mat <- as.matrix(umap[common_cells, 2:3])
colnames(umap_mat) <- c("UMAP_1", "UMAP_2")
rownames(umap_mat) <- common_cells

Tyser[["umap"]] <- CreateDimReducObject(
  embeddings = umap_mat,
  key = "UMAP_",
  assay = DefaultAssay(Tyser)
)

