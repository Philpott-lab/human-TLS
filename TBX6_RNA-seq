##################################################################
############# GGPLOT DotPlot Volcano plot ########################
##################################################################
library(dplyr)
library(ggplot2)
library(ggrepel)

gene_list <- c(
  "mCherry", "TBX21", "TBX2", "RUNX3", "FOXC1",
  "NKX3-2", "OSR1", "LHX1", "MEIS1", "MEIS2",
  "EOMES", "FOXA2", "NANOG"
)

res_frame <- res_frame %>%
  filter(!is.na(padj) & !is.na(log2FoldChange)) %>%
  mutate(
    negLog10p = -log10(padj),
    significance = case_when(
      padj < 0.05 & log2FoldChange >  0.58 ~ "Significant up",
      padj < 0.05 & log2FoldChange < -0.58 ~ "Significant down",
      TRUE                                 ~ "Not significant"
    ),
    is_labelled = gene_name %in% gene_list,
    label_dir = case_when(
      is_labelled & log2FoldChange >  0.58 ~ "Label up",
      is_labelled & log2FoldChange < -0.58 ~ "Label down",
      TRUE                                 ~ NA_character_
    )
  )

# cap infinite -log10(FDR)
max_finite <- max(res_frame$negLog10p[is.finite(res_frame$negLog10p)])
res_frame$negLog10p[is.infinite(res_frame$negLog10p)] <- max_finite + 1

nrow(res_frame[res_frame$significance == "Significant up", ]) #1035
nrow(res_frame[res_frame$significance == "Significant down", ]) #338

# build plot
p <- ggplot(res_frame, aes(x = log2FoldChange, y = negLog10p)) +
  # base layer: all points
  geom_point(aes(color = significance), size = 0.6, alpha = 1) +
  # highlight labelled significant genes
  geom_point(
    data = subset(res_frame, !is.na(label_dir)),
    aes(color = label_dir),
    size = 1
  ) +
  scale_color_manual(values = c(
    "Not significant"  = "grey90",
    "Significant up"   = "#f7c2ac",
    "Significant down" = "#92c5de",
    "Label up"         = "#c90422",
    "Label down"       = "#096fad"
  )) +
  labs(
    x = "log2 fold change",
    y = expression(-log[10](FDR)),
    color = NULL,
    title = "24h dox-TBX6"
  ) +
  theme(
    panel.border = element_rect(colour = "black", fill = NA, size = 1),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    panel.background = element_rect(fill = 'white', colour = 'white'),
    axis.text = element_text(size = 12),
    axis.title = element_text(size = 16),
    legend.position = "none"
  ) + scale_y_continuous(
    trans = scales::pseudo_log_trans(base = 10),
    limits = c(0, max_finite + 1),  # adjust lower bound so nothing goes negative
    breaks = c(1, 10, 50, 100, 200, 300),  # you can tune these
    labels = scales::comma
  ) +
  scale_x_continuous(limits = c(-5, 10)) +
  geom_text_repel(
    data = subset(res_frame, gene_name %in% gene_list),
    aes(label = gene_name),
    color = "black",
    box.padding = 0.5,
    point.padding = 0.6,
    segment.color = "grey80",
    segment.size = 0.2,
    size = 4,
    max.overlaps = 100
  )

p

