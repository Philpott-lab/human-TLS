# Import counts matrix
dox_TBX6_matrix <- read.delim2(
  file = file.path(base_dir, "72KDH3_results", "72KDH3-expression-matrix.csv"),
  header = TRUE,
  sep = ",",
  stringsAsFactors = FALSE
)

# Fill blank gene names with ENS IDs and make names unique
dox_TBX6_matrix <- dox_TBX6_matrix %>%
  dplyr::mutate(gene_name = ifelse(gene_name == "" | is.na(gene_name), gene_id, gene_name))

dox_TBX6_matrix$gene_name <- make.unique(dox_TBX6_matrix$gene_name, sep = ".")
rownames(dox_TBX6_matrix) <- dox_TBX6_matrix$gene_name
dox_TBX6_matrix <- dox_TBX6_matrix[, c(-1, -2, -3)]

# Isolate count columns only
dox_TBX6_counts <- dox_TBX6_matrix %>%
  tibble::as_tibble(rownames = "gene") %>%
  dplyr::select(gene, dplyr::contains("count")) %>%
  dplyr::mutate(dplyr::across(-gene, as.numeric)) %>%
  tibble::column_to_rownames("gene")

# Force integer counts
count_df <- data.frame(
  lapply(dox_TBX6_counts, function(x) as.integer(as.character(x))),
  row.names = rownames(dox_TBX6_counts),
  check.names = FALSE
)

# Convert to matrix and reorder columns
count_mat <- as.matrix(count_df)
count_mat <- count_mat[, c(1, 3, 5, 7, 2, 4, 6, 8)]
count_mat <- count_mat[complete.cases(count_mat), ] # delete rows with NA

# Metadata
metaData <- data.frame(colnames(count_mat))
metaData$treatment <- c("untreated", "untreated", "untreated", "untreated",
                        "dox", "dox", "dox", "dox")

rownames(metaData) <- metaData$colnames.count_mat.
metaData$colnames.count_mat. <- NULL
metaData$treatment <- factor(metaData$treatment)
metaData$treatment <- relevel(metaData$treatment, ref = "untreated")

# Prepare for DESeq2
dds <- DESeqDataSetFromMatrix(
  countData = count_mat,
  colData = metaData,
  design = ~treatment,
  tidy = FALSE
)

###################################
############ Run DESeq2 ###########
###################################

dds <- DESeq(dds)

