safe_logp <- function(p) -log10(pmax(p, .Machine$double.xmin))

top_genes_L1 <- res %>%
  filter(
    pvalue_1vs2 < 0.05, pvalue_1vs3 < 0.05, pvalue_1vs4 < 0.05,
