get_lin_mat <- function(pred_mat, L) {
  
  cols <- grep(
    paste0(
      "^lineage",
      L,
      "_"
    ),
    colnames(pred_mat),
    value = TRUE
  )
  
  if (length(cols) == 0) {
    stop(
      "No columns found for lineage ",
      L
    )
  }
  
  pred_mat[
    ,
    cols,
    drop = FALSE
  ]
}


