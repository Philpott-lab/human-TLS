get_lin_mat <- function(pred_mat, L) {
  cols <- grep(paste0("^lineage", L, "_"), colnames(pred_mat), value = TRUE)
  if (length(cols) == 0) stop("No columns found for lineage ", L)
  pred_mat[, cols, drop = FALSE]
}

m1 <- get_lin_mat(pred80, 1)
m2 <- get_lin_mat(pred80, 2)
m3 <- get_lin_mat(pred80, 3)
m4 <- get_lin_mat(pred80, 4)

prep_log <- function(m, genes) log1p(m[genes, , drop = FALSE])

L1_log <- prep_log(m1, genes80_ordered)
L2_log <- prep_log(m2, genes80_ordered)
L3_log <- prep_log(m3, genes80_ordered)
L4_log <- prep_log(m4, genes80_ordered)

## ---------------------------
## 3) Weighted z-score heatmaps
## ---------------------------
row_z <- function(m) {
  z <- t(scale(t(m)))
  z[is.na(z)] <- 0
  z
}

expr_weight <- function(logm, mid = 0.75, scale = 0.12) {
  1 / (1 + exp(-(logm - mid) / scale))
}

apply_weighted_z <- function(logm, mid = 0.75, scale = 0.12) {
  row_z(logm) * expr_weight(logm, mid = mid, scale = scale)
}

h1 <- apply_weighted_z(L1_log, mid = 0.75, scale = 0.12)
h2 <- apply_weighted_z(L2_log, mid = 0.75, scale = 0.12)
h3 <- apply_weighted_z(L3_log, mid = 0.75, scale = 0.12)
h4 <- apply_weighted_z(L4_log, mid = 0.75, scale = 0.12)

cap <- 2.5
clip <- function(x, cap) pmax(pmin(x, cap), -cap)

h1 <- clip(h1, cap)
h2 <- clip(h2, cap)
h3 <- clip(h3, cap)
h4 <- clip(h4, cap)

col_fun <- circlize::colorRamp2(
  c(-cap, -cap/2, 0, cap/2, cap),
  c("#096fad", "#92c5de", "grey99", "#f7c2ac", "#c90422")
)

ht_width <- unit(6, "cm")

mk_ht <- function(h, id, show_legend = TRUE) {
  Heatmap(
    h,
    name = id,
    col = col_fun,
    cluster_rows = FALSE,
    cluster_columns = FALSE,
    show_row_names = FALSE,
    show_column_names = FALSE,
    show_heatmap_legend = show_legend,
    heatmap_legend_param = list(title = "Weighted z\n(log1p fit)"),
    width = ht_width
  )
}

ht1 <- mk_ht(h1, "L1", show_legend = TRUE)
ht2 <- mk_ht(h2, "L2", show_legend = FALSE)
ht3 <- mk_ht(h3, "L3", show_legend = FALSE)
ht4 <- mk_ht(h4, "L4", show_legend = FALSE)

