#
# For each target population:
#   - compare against all other annotated populations
#   - exclude cells labelled "filtered"
#   - adjusted P < 0.05
#   - positive log2 fold-change
#   - detected in >10% of target cells
#   - retain top 100 genes ranked by log2 fold-change
#
############################################################

DefaultAssay(hTLS) <- "SCT"

Idents(hTLS) <- "full_cluster_annot"


make_module <- function(
  object,
  target_cluster,
  n_genes = 100
) {
  
  other_clusters <- setdiff(
    levels(
      Idents(object)
    ),
    c(
      target_cluster,
      "filtered"
    )
  )
  
  FindMarkers(
    object,
    ident.1 = target_cluster,
    ident.2 = other_clusters,
    logfc.threshold = -Inf,
    min.pct = 0
  ) %>%
    tibble::rownames_to_column(
      "gene"
    ) %>%
    dplyr::filter(
      p_val_adj < 0.05,
      avg_log2FC > 0,
      pct.1 > 0.1
    ) %>%
    dplyr::arrange(
      desc(avg_log2FC)
    ) %>%
    dplyr::slice_head(
      n = n_genes
    ) %>%
    dplyr::pull(
      gene
    )
}


renal_progenitor_like_module <- make_module(
  hTLS,
  target_cluster = "Renal progenitor-like"
)


somite_progenitor_like_module <- make_module(
  hTLS,
  target_cluster = "Somite progenitor"
)


neural_tube_like_module <- make_module(
  hTLS,
  target_cluster = "Neural tube"
)
