draw_heatmap_figure <- function() {
  
  grid::grid.newpage()
  
  ComplexHeatmap::ht_opt(
    ROW_ANNO_PADDING = unit(
      0,
      "mm"
    ),
    COLUMN_ANNO_PADDING = unit(
      0,
      "mm"
    ),
    DIMNAME_PADDING = unit(
      0,
      "mm"
    )
  )
  
  draw(
    ht_list,
    heatmap_legend_side = "right",
    annotation_legend_side = "right",
    merge_legends = TRUE
  )
  
  
  for (
    nm in c(
      "L1",
      "L2",
      "L3",
      "L4"
    )
  ) {
    
    decorate_heatmap_body(
      nm,
      {
        grid::grid.rect(
          gp = grid::gpar(
            fill = NA,
            col = "black",
            lwd = 0.6
          )
        )
      }
    )
  }
  
  
  for (
    nm in c(
      "L1",
      "L2",
      "L3",
      "L4"
    )
  ) {
    
    decorate_heatmap_body(
      nm,
      {
        
        txt <- grid::textGrob(
          "Pseudotime",
          x = unit(
            0,
            "npc"
          ),
          y = unit(
            -2,
            "mm"
          ),
          just = c(
            "left",
            "top"
          ),
          gp = grid::gpar(
            fontsize = 20,
            col = "grey30"
          )
        )
        
        grid::grid.draw(
          txt
        )
        
        grid::grid.lines(
          x = unit.c(
            grobWidth(txt) +
              unit(
                1.5,
                "mm"
              ),
            unit(
              0.95,
              "npc"
            )
          ),
          y = unit(
            c(
              -3,
              -3
            ),
            "mm"
          ),
          arrow = grid::arrow(
            type = "closed",
            length = unit(
              1.8,
              "mm"
            )
          ),
          gp = grid::gpar(
            col = "grey10",
            fill = "grey10",
            lwd = 1
          )
        )
      }
    )
  }
}


