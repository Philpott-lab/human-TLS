## ------------------------------------------------------------
## tradeSeq + slingshot on hTLS.mes using sparse RNA counts
## keeps 4 lineages, uses all genes after filtering, no chunking
## ------------------------------------------------------------

library(Seurat)
library(slingshot)
library(tradeSeq)
library(Matrix)
library(SingleCellExperiment)
library(BiocParallel)
library(mgcv)

## ---- 0) Basic options ----
set.seed(7)
options(stringsAsFactors = FALSE)
options(timeout = max(3000, getOption("timeout")))

## ---- 1) Make sure RNA assay is active ----
DefaultAssay(hTLS.mes) <- "RNA"

## ---- 2) Check available mesoderm cluster labels ----
table(hTLS.mes$mes_cluster_annot)
unique(hTLS.mes$mes_cluster_annot)

## ---- 3) Set lineage root and endpoints manually ----
## CHANGE THESE to match your mes_cluster_annot labels
start_clust <- "Early Mesoderm"
end_clusts  <- c("Nephron tube", "Podocyte", "Somite - muscle lineage", "Somite - mesenchyme")

## ---- 4) Run slingshot on published mesoderm UMAP ----
crv <- slingshot(
  Embeddings(hTLS.mes, "umap_published"),
  clusterLabels = hTLS.mes$mes_cluster_annot,
  start.clus    = start_clust,
  end.clus      = end_clusts,
  stretch       = 0,
  approx_points = 20
)

## ---- 5) Extract pseudotime and lineage weights ----
pseudotime  <- slingPseudotime(crv, na = FALSE)   # cells x lineages
cellWeights <- slingCurveWeights(crv)             # cells x lineages

## ---- 6) Get sparse RNA counts (genes x cells) ----
counts <- GetAssayData(hTLS.mes, assay = "RNA", slot = "counts")

if (!inherits(counts, "dgCMatrix")) {
  counts <- as(counts, "dgCMatrix")
}

## ---- 7) Gene filtering ----
## Keep genes expressed in >6% of cells
keep_frac <- Matrix::rowMeans(counts > 0) > 0.06
counts <- counts[keep_frac, , drop = FALSE]

## Remove extremely sparse tail
nz  <- Matrix::rowSums(counts > 0)
cut <- as.numeric(quantile(nz, probs = 0.005, names = FALSE))
keep_nz <- nz > cut
counts  <- counts[keep_nz, , drop = FALSE]

## ---- 8) Align cell order between counts and pseudotime/weights ----
common_cells <- intersect(colnames(counts), rownames(pseudotime))

counts      <- counts[, common_cells, drop = FALSE]
pseudotime  <- pseudotime[common_cells, , drop = FALSE]
cellWeights <- cellWeights[common_cells, , drop = FALSE]




