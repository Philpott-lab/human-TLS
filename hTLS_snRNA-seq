## ---- 9) BiocParallel setup ----
bp <- SnowParam(
  workers = 3,
  type = "SOCK",
  progressbar = TRUE,
  stop.on.error = TRUE,
  timeout = 60 * 60 * 24
)

gam_ctrl <- mgcv::gam.control(
  maxit = 50,
  trace = FALSE
)

## ---- 10) fitGAM ----
sce <- fitGAM(
  counts      = counts,
  pseudotime  = pseudotime,
  cellWeights = cellWeights,
  nknots      = 6,
  verbose     = TRUE,
  BPPARAM     = bp,
  control     = gam_ctrl
)

## ---- 11) Save result ----
saveRDS(
  sce,
  file = "~/Desktop/hTLS_mes_tradeSeq_fitGAM_sparse_allgenes_4lineages_6knots_6pct.rds"
)

